# Postgres (docker-compose na raiz do repo)
DATABASE_URL="postgresql://autoos:autoos_dev@localhost:5432/autoos"

# Sessão (RF-01/RF-02) — gere valores reais, nunca reaproveite estes em produção
JWT_SECRET="change-me"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# Login com Google (RF-01) — pendente: criar projeto no Google Cloud Console
# e configurar um OAuth Client ID. Sem isso, postLogin não completa
# (verifyIdToken falha) — ver docs/PHASES.md, "fora do escopo desta rodada".
