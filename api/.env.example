# Telemetria → LARCC (RF-14/RF-15) — pendente: credencial real do broker.
# Ver contract/mqtt-topics.md, Known Gaps.
LARCC_MQTT_HOST=""
LARCC_MQTT_PORT="8883"

PORT="3000"

# Seed (prisma/seed.ts): e-mail da conta Google que vai entrar (RF-01, sem auto-cadastro)
SEED_USER_EMAIL="machado.gustavo2905@gmail.com"
