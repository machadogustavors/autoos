# Lido pelo Expo no build (prefixo EXPO_PUBLIC_). Nada aqui é segredo de verdade:
# tudo que vai no bundle do app é extraível — ver docs/PHASES.md, Fase 11.

# API AutoOS (HTTPS) — emulador Android acessa o host em 10.0.2.2
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000/v1"

# Login com Google (RF-01): Web client ID do projeto no Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# Telemetria → LARCC (RF-14). MQTT sobre TLS via WebSocket (wss://).
# Vazio = publicação desligada (o fluxo transacional segue normal, RNF-04).
EXPO_PUBLIC_LARCC_MQTT_URL=""
EXPO_PUBLIC_WORKSHOP_ID="wm"
# Chave do HMAC do vehicleHash (RF-15).
EXPO_PUBLIC_VEHICLE_HASH_KEY=""
